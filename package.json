{
  "name": "asapio-aci-docs",
  "displayName": "ASAPIO Docs MCP",
  "description": "MCP Server for ASAPIO Integration Add-on Documentation – search and retrieve docs directly in GitHub Copilot Chat",
  "version": "1.2.3",
  "publisher": "ASAPIO",
  "author": "ASAPIO GmbH <info@asapio.com>",
  "license": "MIT",
  "icon": "images/icon.png",
  "homepage": "https://asapio.com/docs",
  "repository": {
    "type": "git",
    "url": "https://github.com/AsapioCompany/asapio-aci-docs-vscode.git"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "asapio",
    "aci",
    "mcp",
    "documentation",
    "copilot",
    "sap",
    "integration",
    "s4hana"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "configuration": {
      "title": "ASAPIO ACI Docs",
      "properties": {
        "asapioAciDocs.cacheTtlSeconds": {
          "type": "number",
          "default": 86400,
          "description": "How long to cache documentation pages (in seconds)"
        }
      }
    },
    "commands": [
      {
        "command": "asapio-reload",
        "title": "ASAPIO: Reload Documentation Cache"
      },
      {
        "command": "asapio-status",
        "title": "ASAPIO: Show Status"
      },
      {
        "command": "asapio-search",
        "title": "ASAPIO: Search Documentation"
      },
      {
        "command": "asapio-list",
        "title": "ASAPIO: List Documentation Pages"
      },
      {
        "command": "asapio-get",
        "title": "ASAPIO: Get Section from Page"
      },
      {
        "command": "asapio-outline",
        "title": "ASAPIO: Show Page Outline"
      },
      {
        "command": "asapio.asapio",
        "title": "/asapio: Search ASAPIO Documentation"
      },
      {
        "command": "asapio.detectInPalette",
        "title": "ASAPIO: Detect 'asapio' in Command Palette Input"
      }
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "marked": "^10.0.0",
    "node-html-parser": "^7.1.0",
    "zod": "^4.3.6"
  },
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.99.0",
    "@vscode/vsce": "^3.0.0"
  }
}
